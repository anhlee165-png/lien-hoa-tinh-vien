rules_version = '2';
// Nhạc trong điện: ai cũng nghe được; chỉ tài khoản có claim admin (máy chủ cấp) mới tải lên / xoá.
service firebase.storage {
  match /b/{bucket}/o {
    match /nhac/{file} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.token.admin == true
        && file.matches('[A-Za-z0-9_.-]{1,80}')
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
    match /{all=**} { allow read, write: if false; }
  }
}
