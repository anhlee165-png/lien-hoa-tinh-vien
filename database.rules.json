{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$hall": {
        ".read": "$hall.matches(/^h([1-9]|1[0-9]|20)$/)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $hall.matches(/^h([1-9]|1[0-9]|20)$/)",
          ".validate": "newData.hasChildren(['name', 'room', 't']) && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('room').isString() && newData.child('room').val().length <= 20 && newData.child('t').val() <= now + 60000",
          "abbot": {
            ".validate": "newData.val() === true && auth.token.admin === true"
          },
          "sheet": {
            ".validate": "newData.val() === 'nu' || newData.val() === 'nam'"
          },
          "$other": {
            ".validate": "$other === 'name' || $other === 'room' || $other === 't' || $other === 'sheet' || $other === 'abbot'"
          }
        }
      }
    },
    "chat": {
      "$hall": {
        "$room": {
          ".read": "$hall.matches(/^h([1-9]|1[0-9]|20)$/) && $room.matches(/^[a-z-]{1,20}$/)",
          ".indexOn": [
            "t"
          ],
          "$msg": {
            ".write": "$hall.matches(/^h([1-9]|1[0-9]|20)$/) && $room.matches(/^[a-z-]{1,20}$/) && auth != null && auth.provider !== 'anonymous' && ((!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && (auth.token.admin === true || data.child('uid').val() === auth.uid || data.child('t').val() < now - 86400000)))",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 't']) && newData.child('t').val() === now && newData.parent().parent().parent().parent().child('chatLast').child(auth.uid).val() === now",
            "uid": {
              ".validate": "newData.val() === auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "admin": {
              ".validate": "newData.val() === true && auth.token.admin === true"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "chatLast": {
      "$uid": {
        ".write": "auth != null && auth.provider !== 'anonymous' && auth.uid === $uid",
        ".validate": "newData.val() === now && (!data.exists() || data.val() < now - 1500)"
      }
    }
  }
}
